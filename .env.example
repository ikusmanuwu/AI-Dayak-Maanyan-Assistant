# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TELEGRAM_BOT_TOKEN: Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# ENABLE_TELEGRAM_POLLER: Set to 'true' to force poller on any environment (default: auto in Railway/Production)
ENABLE_TELEGRAM_POLLER="true"

# TURSO_DATABASE_URL: Turso Database URL (e.g., libsql://your-db-org.turso.io)
TURSO_DATABASE_URL=""

# TURSO_AUTH_TOKEN: Turso database authentication token
TURSO_AUTH_TOKEN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
