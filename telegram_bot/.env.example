# .env (Salin file ini menjadi .env)
# Panduan mendapatkan token ada di README.md

# 1. Token Bot Telegram dari @BotFather di Telegram (GRATIS)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuVWXyz"

# 2. Google Gemini API Key dari Google AI Studio (GRATIS di https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 3. Model Gemini yang digunakan (Rekomendasi default: gemini-3.6-flash)
GEMINI_MODEL="gemini-3.6-flash"
